# API Configuration
API_BASE_URL=http://localhost:3000
API_PORT=3000

# Database Configuration (Cloud)
DATABASE_URL=postgresql://user:password@localhost/orchestra_box_office
DATABASE_POOL_SIZE=10

# Database Configuration (Desktop)
DB_PATH=orchestra_box_office.db
DB_PASSWORD=

# Encryption Keys (should be set via OS keychain in production)
ENCRYPTION_KEY=

# Feature Flags
ENABLE_INTEGRATIONS=true
ENABLE_SYNC=false

# Logging
RUST_LOG=orchestra_box_office=debug,axum=debug
LOG_LEVEL=info

# Environment
ENVIRONMENT=development
